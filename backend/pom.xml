<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================= -->
    <!-- CONFIGURAÇÃO DO SPRING BOOT               -->
    <!-- ========================================= -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <!-- Identificação do projeto -->
    <groupId>com.kanban</groupId>
    <artifactId>api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Kanban Corporativo API</name>
    <description>API REST para gerenciamento de tarefas, equipes e usuários</description>

    <!-- Versão do Java utilizada no projeto -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- ========================================= -->
    <!-- DEPENDÊNCIAS DO PROJETO                   -->
    <!-- ========================================= -->
    <dependencies>

        <!-- Persistência de dados com JPA/Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Desenvolvimento de APIs REST e controllers HTTP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Validação de dados com Jakarta Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===================================== -->
        <!-- BANCO DE DADOS                       -->
        <!-- ===================================== -->

        <!-- Driver JDBC para conexão com PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===================================== -->
        <!-- MIGRAÇÕES DO BANCO COM FLYWAY         -->
        <!-- ===================================== -->

        <!-- Integração do Flyway com Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <!-- Suporte do Flyway ao PostgreSQL -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ===================================== -->
        <!-- TESTES AUTOMATIZADOS                  -->
        <!-- ===================================== -->

        <!-- Testes da camada de persistência JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testes dos controllers e endpoints HTTP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ========================================= -->
    <!-- CONFIGURAÇÃO DE BUILD                     -->
    <!-- ========================================= -->
    <build>
        <plugins>

            <!-- Plugin para empacotar e executar a aplicação Spring Boot -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
